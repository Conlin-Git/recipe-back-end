# 环境变量（含密钥）
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv
.python-version

# Docker 数据卷（MySQL / Milvus / Neo4j 本地数据）
data/
# 命理命名规则是可部署的源码数据，不随 Docker 运行时数据忽略
!app/naming/data/
!app/naming/data/*.json

# 日志
*.log

# 系统文件
.DS_Store

# IDE
.vscode/
.idea/

# 头像
uploads/avatars/*
!uploads/avatars/.gitkeep
# local restore backups
data-local-backup-*/
data/mysql-failed-*/
